# Copia este fichero a .env y ajusta los valores. No subir .env a git.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biblioteca_digital
DB_USER=root
DB_PASS=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Biblioteca Digital

# URL base pública de la app (sin / final). Se usa para el enlace de activación.
# Ejemplo XAMPP: http://localhost/BiblioDigital
APP_URL=http://localhost/BiblioDigital
